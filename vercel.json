{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(about|admin|index|map|news-write|property-news|news-detail)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "redirects": [
    { "source": "/news", "destination": "/property-news?v=20260715_v53", "permanent": false },
    { "source": "/news.html", "destination": "/property-news?v=20260715_v53", "permanent": false }
  ],
  "routes": [
    { "src": "^/news-detail(?:\\.html)?(?:\\?.*)?$", "dest": "/api/news-detail" },
    { "src": "^/templates/news-detail(?:\\.html)?(?:\\?.*)?$", "dest": "/api/news-detail" },
    { "src": "^/rss(?:\\.xml)?$", "dest": "/api/rss" },
    { "src": "^/sitemap(?:\\.xml)?$", "dest": "/api/sitemap" }
  ]
}
